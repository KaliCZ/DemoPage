# The deploy rewrites Image= to the digest it just verified; :latest is only a placeholder.
# Network=host, so these ports must never overlap the API slots' ports.

[Unit]
Description=Kalandra MCP server (blue slot)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/kalicz/demopage/mcp:latest
ContainerName=kalandra-mcp-blue
Network=host
EnvironmentFile=%h/demoPage/kalandra-mcp.env
Environment=ASPNETCORE_HTTP_PORTS=8082
Environment=ASPNETCORE_ENVIRONMENT=Production
Pull=missing

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target
