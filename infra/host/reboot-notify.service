# System-level (root) so it runs regardless of who's logged in; install per infra/host/os-updates.md.
[Unit]
Description=Notify Slack when the host needs a reboot to finish updates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/slack-notify.env
ExecStart=/usr/local/bin/reboot-notify.sh
