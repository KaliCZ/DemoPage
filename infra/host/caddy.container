# Fronts every app on the box; host infra installed once per machine (see docs/architecture/deployment.md), never by an app's deploy.
# Rootless 80/443 needs sysctl net.ipv4.ip_unprivileged_port_start=80, and boot autostart needs `loginctl enable-linger opc`.

[Unit]
Description=Shared Caddy reverse proxy
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=caddy
Network=host
Volume=/srv/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,z
Volume=/srv/caddy/sites:/etc/caddy/sites:ro,z
Volume=/srv/caddy/certs:/etc/caddy/certs:ro,z
Volume=caddy-data.volume:/data
Volume=caddy-config.volume:/config
Pull=missing

[Service]
Restart=on-failure
TimeoutStartSec=60

[Install]
WantedBy=default.target
