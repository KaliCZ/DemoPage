<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <ItemGroup>
    <ProjectReference Include="..\..\backend\src\Kalandra.Api\Kalandra.Api.csproj" />
    <ProjectReference Include="..\..\backend\src\Kalandra.McpServer\Kalandra.McpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>0f8ea75e-f640-4bc7-ace3-b1cd6369f724</UserSecretsId>
    <!-- DCP and the dashboard come from NuGet so the AppHost builds without the Aspire CLI, which CI doesn't install. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

</Project>
