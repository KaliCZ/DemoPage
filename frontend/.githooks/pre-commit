#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep '^frontend/' \
  | grep -E '\.(astro|ts|js|json|css|mjs)$' || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

# Run from frontend/ so Prettier resolves prettier-plugin-astro from frontend/node_modules.
echo "$STAGED" | sed 's|^frontend/||' \
  | (cd "$REPO_ROOT/frontend" && xargs npx prettier --write --ignore-unknown)

echo "$STAGED" | xargs git add
