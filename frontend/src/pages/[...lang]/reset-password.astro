---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import { locales, defaultLocale, localePath, type Locale } from "../../i18n/utils";
import enStrings from "../../i18n/en/reset-password.json";
import csStrings from "../../i18n/cs/reset-password.json";

const translations = { en: enStrings, cs: csStrings };

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang: lang === defaultLocale ? undefined : lang },
  }));
}

const lang = (Astro.params.lang ?? defaultLocale) as Locale;
const t = translations[lang];

const inputClass =
  "w-full px-4 py-3 rounded-xl bg-surface-container border border-outline-variant/20 text-on-surface font-body text-sm placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors";
const labelClass = "block text-sm font-label font-semibold text-on-surface mb-1.5";
---

<Layout title={t.meta.title} description={t.meta.description} activePage="reset-password" lang={lang} noindex>
  <section class="max-w-3xl mx-auto px-8 mb-16">
    <h1 class="font-headline text-5xl md:text-7xl font-extrabold tracking-tighter leading-none mb-6">
      <span class="gradient-text text-primary bg-linear-to-r from-primary to-tertiary">{t.hero.title}</span>
    </h1>
    <p class="text-lg text-on-surface-variant font-body max-w-xl">{t.hero.subtitle}</p>
  </section>

  <section id="reset-loading" class="max-w-3xl mx-auto px-8 mb-16">
    <div class="text-center py-12">
      <Icon name="material-symbols:progress-activity" class="size-[30px] text-on-surface-variant animate-spin" aria-hidden="true" />
    </div>
  </section>

  <section id="reset-invalid" class="hidden max-w-3xl mx-auto px-8 mb-16">
    <div class="bg-surface-container-low rounded-2xl border border-outline-variant/10 p-8 md:p-12 text-center">
      <Icon name="material-symbols:link-off" class="size-12 text-primary mb-4 mx-auto block" aria-hidden="true" />
      <h2 class="font-headline text-2xl font-bold text-on-surface mb-3">{t.invalidLink.title}</h2>
      <p class="text-on-surface-variant font-body mb-6">{t.invalidLink.description}</p>
      <button
        id="reset-request-new-link"
        type="button"
        class="px-6 py-3 rounded-xl text-sm font-semibold font-label bg-primary text-on-primary hover:bg-primary/90 transition-colors cursor-pointer"
      >
        {t.invalidLink.requestNewLink}
      </button>
    </div>
  </section>

  <section id="reset-form-section" class="hidden max-w-3xl mx-auto px-8 mb-16">
    <form
      id="reset-form"
      novalidate
      class="bg-surface-container-low rounded-2xl border border-outline-variant/10 p-8 md:p-12 space-y-4"
      data-save={t.form.save}
      data-saving={t.form.saving}
      data-success={t.form.success}
      data-too-short={t.form.tooShort}
      data-mismatch={t.form.mismatch}
      data-home-path={localePath(lang, "home")}
    >
      <div>
        <label for="reset-account-email" class={labelClass}>
          {t.form.account}
        </label>
        <!-- Tells password managers which account the new password belongs to. -->
        <input type="email" id="reset-account-email" autocomplete="username" readonly class={`${inputClass} opacity-70`} />
      </div>
      <div>
        <label for="reset-new-password" class={labelClass}>
          {t.form.newPassword}
        </label>
        <input
          type="password"
          id="reset-new-password"
          autocomplete="new-password"
          required
          minlength="6"
          placeholder={t.form.newPasswordPlaceholder}
          aria-describedby="reset-error"
          class={inputClass}
        />
      </div>
      <div>
        <label for="reset-confirm-password" class={labelClass}>
          {t.form.confirmPassword}
        </label>
        <input
          type="password"
          id="reset-confirm-password"
          autocomplete="new-password"
          required
          minlength="6"
          placeholder={t.form.confirmPasswordPlaceholder}
          aria-describedby="reset-error"
          class={inputClass}
        />
      </div>
      <p id="reset-error" role="alert" class="hidden text-error text-sm font-body"></p>
      <button
        type="submit"
        id="reset-submit"
        class="w-full px-4 py-3 rounded-xl text-sm font-semibold font-label bg-primary text-on-primary hover:bg-primary/90 transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
      >
        {t.form.save}
      </button>
    </form>
  </section>

  <script>
    import { getSupabaseClient } from "../../lib/supabase";
    import { openPasswordResetDialog } from "../../lib/auth";
    import { track } from "../../lib/observability";
    import { sameOriginPath } from "../../lib/redirect";

    // GoTrue lets sessions opened from an emailed link set a password without knowing the current one.
    const EMAIL_LINK_AUTH_METHODS = ["otp", "magiclink", "recovery"];

    const SECTIONS = ["reset-loading", "reset-invalid", "reset-form-section"];
    const show = (id: string) =>
      SECTIONS.forEach((section) => document.getElementById(section)?.classList.toggle("hidden", section !== id));

    const form = document.getElementById("reset-form") as HTMLFormElement;
    const strings = form.dataset;
    const accountEmail = document.getElementById("reset-account-email") as HTMLInputElement;
    const newPassword = document.getElementById("reset-new-password") as HTMLInputElement;
    const confirmPassword = document.getElementById("reset-confirm-password") as HTMLInputElement;
    const errorMessage = document.getElementById("reset-error") as HTMLElement;
    const submit = document.getElementById("reset-submit") as HTMLButtonElement;

    async function sessionOpenedFromEmailLink(): Promise<boolean> {
      const supabase = await getSupabaseClient();
      if (!supabase) return false;
      const { data } = await supabase.auth.getClaims();
      const methods = (data?.claims.amr ?? []).map((entry) => (typeof entry === "string" ? entry : entry.method));
      return methods.some((method) => EMAIL_LINK_AUTH_METHODS.includes(method));
    }

    function showError(message: string) {
      errorMessage.textContent = message;
      errorMessage.classList.remove("hidden");
    }

    function setBusy(busy: boolean) {
      submit.disabled = busy;
      submit.textContent = busy ? strings.saving! : strings.save!;
    }

    window.addEventListener("auth-change", async (event) => {
      const user = (event as CustomEvent).detail?.user;
      if (!user || !(await sessionOpenedFromEmailLink())) {
        show("reset-invalid");
        return;
      }
      accountEmail.value = user.email ?? "";
      show("reset-form-section");
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorMessage.classList.add("hidden");
      if (newPassword.value.length < 6) return showError(strings.tooShort!);
      if (newPassword.value !== confirmPassword.value) return showError(strings.mismatch!);

      setBusy(true);
      const supabase = (await getSupabaseClient())!;
      const { error } = await supabase.auth.updateUser({ password: newPassword.value });
      if (error) {
        setBusy(false);
        return showError(error.message);
      }

      track("password-reset");
      sessionStorage.setItem("snackbar", JSON.stringify({ message: strings.success, type: "success" }));
      window.location.replace(sameOriginPath(new URLSearchParams(window.location.search).get("next"), strings.homePath!));
    });

    document.getElementById("reset-request-new-link")?.addEventListener("click", openPasswordResetDialog);
  </script>
</Layout>
