---
/** Sign-in / sign-up / password-reset dialog, opened from anywhere via `window.__openAuthDialog(mode?)`. */
import { Icon } from "astro-icon/components";
import IconGoogle from "./icons/IconGoogle.astro";
import { localePath, type Locale } from "../i18n/utils";
import enCommon from "../i18n/en/common.json";
import csCommon from "../i18n/cs/common.json";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = lang === "cs" ? csCommon : enCommon;
---

<dialog
  id="auth-dialog"
  data-reset-password-path={localePath(lang, "reset-password")}
  data-home-path={localePath(lang, "home")}
  class="m-auto bg-surface-container-low rounded-2xl border border-outline-variant/10 p-8 max-w-sm w-full backdrop:bg-black/50"
>
  <button
    type="button"
    id="auth-dialog-close"
    aria-label={t.auth.close}
    title={t.auth.close}
    class="absolute top-4 right-4 rounded-lg p-2.5 text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface cursor-pointer"
  >
    <Icon name="material-symbols:close" class="size-6" aria-hidden="true" />
  </button>
  <div class="space-y-5">
    <div>
      <h2 id="auth-dialog-title" class="font-headline text-xl font-bold text-on-surface">
        {t.auth.signIn}
      </h2>
      <p id="auth-dialog-description" class="hidden mt-2 text-sm font-body text-on-surface-variant">
        {t.auth.resetPasswordDescription}
      </p>
    </div>

    <div class="space-y-3">
      <div>
        <label for="auth-email" class="block text-sm font-label font-semibold text-on-surface mb-1.5">
          {t.auth.email}
        </label>
        <input
          type="email"
          id="auth-email"
          autocomplete="email"
          aria-describedby="auth-dialog-error"
          placeholder={t.auth.emailPlaceholder}
          required
          class="w-full px-4 py-3 rounded-xl bg-surface-container border border-outline-variant/20 text-on-surface font-body text-sm placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
        />
      </div>
      <div id="auth-password-field">
        <label for="auth-password" class="block text-sm font-label font-semibold text-on-surface mb-1.5">
          {t.auth.password}
        </label>
        <input
          type="password"
          id="auth-password"
          placeholder={t.auth.passwordPlaceholder}
          required
          minlength="6"
          class="w-full px-4 py-3 rounded-xl bg-surface-container border border-outline-variant/20 text-on-surface font-body text-sm placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
        />
        <div class="mt-1.5 text-right">
          <button
            type="button"
            id="auth-dialog-forgot"
            class="text-xs font-label font-semibold text-primary hover:underline cursor-pointer"
          >
            {t.auth.forgotPassword}
          </button>
        </div>
      </div>
    </div>

    <div id="auth-turnstile-container" class="flex justify-center empty:hidden"></div>

    <p id="auth-dialog-error" role="alert" class="hidden text-error text-sm font-body"></p>

    <button
      type="button"
      id="auth-dialog-submit"
      class="w-full px-4 py-3 rounded-xl text-sm font-semibold font-label bg-primary text-on-primary hover:bg-primary/90 transition-colors cursor-pointer"
    >
      {t.auth.signIn}
    </button>

    <p id="auth-dialog-toggle" class="text-center text-sm font-body text-on-surface-variant">
      {t.auth.noAccount}
      <button type="button" id="auth-dialog-switch" class="text-primary font-semibold hover:underline cursor-pointer">
        {t.auth.signUp}
      </button>
    </p>

    <div id="auth-dialog-alternatives" class="space-y-5">
      <div class="flex items-center gap-3">
        <div class="flex-1 border-t border-outline-variant/20"></div>
        <span class="text-xs font-label text-on-surface-variant">{t.auth.or}</span>
        <div class="flex-1 border-t border-outline-variant/20"></div>
      </div>

      <button
        type="button"
        id="auth-dialog-google"
        class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold font-label bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors cursor-pointer"
      >
        <IconGoogle class="w-5 h-5" />
        {t.auth.continueWithGoogle}
      </button>
    </div>
  </div>
</dialog>

<script
  define:vars={{
    authSignInLabel: t.auth.signIn,
    authSignUpLabel: t.auth.signUp,
    authNoAccountLabel: t.auth.noAccount,
    authHaveAccountLabel: t.auth.haveAccount,
    authConfirmationSentLabel: t.auth.confirmationSent,
    authVerifyingLabel: t.auth.verifying,
    authResetPasswordLabel: t.auth.resetPassword,
    authSendResetLinkLabel: t.auth.sendResetLink,
    authRememberedPasswordLabel: t.auth.rememberedPassword,
    authResetLinkSentLabel: t.auth.resetLinkSent,
    authSigningInLabel: t.auth.signingIn,
    authCreatingAccountLabel: t.auth.creatingAccount,
    authSendingResetLinkLabel: t.auth.sendingResetLink,
    authCaptchaUnavailableLabel: t.auth.captchaUnavailable,
    authServiceUnavailableLabel: t.auth.serviceUnavailable,
    authResetUnavailableLabel: t.auth.resetUnavailable,
    authNetworkErrorLabel: t.errors.networkError,
  }}
>
  window.__authDialogLabels = {
    signIn: authSignInLabel,
    signUp: authSignUpLabel,
    noAccount: authNoAccountLabel,
    haveAccount: authHaveAccountLabel,
    confirmationSent: authConfirmationSentLabel,
    verifying: authVerifyingLabel,
    resetPassword: authResetPasswordLabel,
    sendResetLink: authSendResetLinkLabel,
    rememberedPassword: authRememberedPasswordLabel,
    resetLinkSent: authResetLinkSentLabel,
    signingIn: authSigningInLabel,
    creatingAccount: authCreatingAccountLabel,
    sendingResetLink: authSendingResetLinkLabel,
    captchaUnavailable: authCaptchaUnavailableLabel,
    serviceUnavailable: authServiceUnavailableLabel,
    resetUnavailable: authResetUnavailableLabel,
    networkError: authNetworkErrorLabel,
  };
</script>

<script>
  import type { AuthDialogMode } from "../lib/auth";
  import { getSupabaseClient } from "../lib/supabase";
  import {
    createTurnstile,
    whenTurnstileReady,
    turnstileEnabled,
    shouldForceInteractive,
    recordFailure,
    recordSuccess,
  } from "../lib/turnstile";

  let authDialogMode: AuthDialogMode = "signin";
  let authDialogRevision = 0;

  // createTurnstile is exposed on window for future reuse (e.g. a profile password change).
  const authTurnstile = createTurnstile("#auth-turnstile-container");
  (window as any).__createTurnstile = createTurnstile;

  // Device-wide, not per email: switching emails in the same browser is still the same person.
  const AUTH_FAIL_KEY = "auth-fail";
  // Counts successful signups — more than one account per window is suspicious.
  const AUTH_SIGNUP_KEY = "auth-signup";
  const SIGNUP_WINDOW_MS = 4 * 60 * 60 * 1000;

  let turnstileRendered = false;

  // Execute on submit so the token cannot expire while the user fills the form.
  function renderAuthTurnstile() {
    if (!turnstileEnabled()) return;
    const force = shouldForceInteractive(AUTH_FAIL_KEY) || shouldForceInteractive(AUTH_SIGNUP_KEY, 1, SIGNUP_WINDOW_MS);
    authTurnstile.render({
      appearance: force ? "always" : "interaction-only",
      execution: "execute",
    });
    turnstileRendered = true;
  }

  async function ensureTurnstileRendered(revision: number): Promise<boolean> {
    if (turnstileRendered) return true;
    if (!(await whenTurnstileReady()) || revision !== authDialogRevision) return false;
    if (!turnstileRendered) renderAuthTurnstile();
    return true;
  }

  async function openAuthDialog(mode: AuthDialogMode = "signin") {
    const supabase = await getSupabaseClient();
    if (!supabase) return;
    authDialogMode = mode;
    updateAuthDialogMode();
    setSubmitBusy(authSubmitInFlight);
    (document.getElementById("auth-dialog") as HTMLDialogElement)?.showModal();
    if (turnstileEnabled()) {
      // Submission retries and reports any preload failure.
      void ensureTurnstileRendered(authDialogRevision).catch(() => {});
    }
  }

  function updateAuthDialogMode() {
    const labels = (window as any).__authDialogLabels;
    const title = document.getElementById("auth-dialog-title");
    const submit = document.getElementById("auth-dialog-submit");
    const toggle = document.getElementById("auth-dialog-toggle");
    const switchBtn = document.getElementById("auth-dialog-switch");
    const errorEl = document.getElementById("auth-dialog-error");

    if (errorEl) {
      errorEl.classList.add("hidden");
      errorEl.className = "hidden text-error text-sm font-body";
    }

    const modeLabels: Record<AuthDialogMode, { title: string; submit: string; togglePrompt: string; toggleAction: string }> = {
      signin: { title: labels.signIn, submit: labels.signIn, togglePrompt: labels.noAccount, toggleAction: labels.signUp },
      signup: { title: labels.signUp, submit: labels.signUp, togglePrompt: labels.haveAccount, toggleAction: labels.signIn },
      reset: {
        title: labels.resetPassword,
        submit: labels.sendResetLink,
        togglePrompt: labels.rememberedPassword,
        toggleAction: labels.signIn,
      },
    };
    const current = modeLabels[authDialogMode];
    if (title) title.textContent = current.title;
    if (submit) submit.textContent = current.submit;
    if (toggle) toggle.childNodes[0].textContent = current.togglePrompt + " ";
    if (switchBtn) switchBtn.textContent = current.toggleAction;

    const isReset = authDialogMode === "reset";
    document.getElementById("auth-dialog-description")?.classList.toggle("hidden", !isReset);
    document.getElementById("auth-password-field")?.classList.toggle("hidden", isReset);
    document.getElementById("auth-dialog-forgot")?.classList.toggle("hidden", authDialogMode !== "signin");
    document.getElementById("auth-dialog-alternatives")?.classList.toggle("hidden", isReset);
  }

  // Reset links go through /auth/callback, the only page allowed to receive session tokens in the URL.
  function passwordResetRedirectUrl(): string {
    const { resetPasswordPath, homePath } = (document.getElementById("auth-dialog") as HTMLDialogElement).dataset;
    const here = new URL(window.location.href);
    // Asking for a fresh link from the reset page itself keeps that page's original destination.
    const returnTo = here.pathname === resetPasswordPath ? (here.searchParams.get("next") ?? homePath!) : here.pathname + here.search;
    const next = `${resetPasswordPath}?next=${encodeURIComponent(returnTo)}`;
    return `${window.location.origin}/auth/callback?next=${encodeURIComponent(next)}`;
  }

  function setSubmitBusy(busy: boolean, message?: string) {
    const submit = document.getElementById("auth-dialog-submit") as HTMLButtonElement | null;
    if (!submit) return;
    const labels = (window as any).__authDialogLabels;
    submit.disabled = busy;
    submit.setAttribute("aria-busy", String(busy));
    for (const id of ["auth-email", "auth-password", "auth-dialog-switch", "auth-dialog-forgot", "auth-dialog-google"]) {
      const control = document.getElementById(id) as HTMLInputElement | HTMLButtonElement | null;
      if (control) control.disabled = busy;
    }
    submit.classList.toggle("opacity-60", busy);
    submit.classList.toggle("cursor-not-allowed", busy);
    if (busy) {
      submit.dataset.prevText ??= submit.textContent || "";
      submit.textContent = message ?? labels.verifying;
    } else if (submit.dataset.prevText) {
      submit.textContent = submit.dataset.prevText;
      delete submit.dataset.prevText;
    }
  }

  async function requestFreshCaptchaToken(revision: number): Promise<string> {
    if (!turnstileEnabled()) return "";
    if (!(await ensureTurnstileRendered(revision))) return "";
    authTurnstile.execute();
    return authTurnstile.waitForToken(15000);
  }

  // Supabase saves the session before returning, so closing the dialog must not unlock another submission.
  let authSubmitInFlight = false;

  function showAuthError(message: string) {
    const errorEl = document.getElementById("auth-dialog-error");
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.className = "text-error text-sm font-body";
    }
  }

  async function authDialogSubmit() {
    if (authSubmitInFlight) return;
    const emailInput = document.getElementById("auth-email") as HTMLInputElement;
    const passwordInput = document.getElementById("auth-password") as HTMLInputElement;
    if (!emailInput.reportValidity()) return;
    if (authDialogMode !== "reset" && !passwordInput.reportValidity()) return;
    const revision = authDialogRevision;
    const focusedControl = document.activeElement;
    authSubmitInFlight = true;
    setSubmitBusy(true);
    try {
      await authDialogSubmitInner(revision);
    } catch (error) {
      window.observability?.captureException(error, { operation: "auth-dialog-submit" });
      if (revision === authDialogRevision) showAuthError((window as any).__authDialogLabels.serviceUnavailable);
    } finally {
      authSubmitInFlight = false;
      setSubmitBusy(false);
      if (revision === authDialogRevision) {
        authTurnstile.remove();
        turnstileRendered = false;
        if (authDialogElement?.open && document.activeElement === document.body && focusedControl instanceof HTMLElement) {
          focusedControl.focus();
        }
      }
    }
  }

  async function authDialogSubmitInner(revision: number) {
    const supabase = await getSupabaseClient();
    if (revision !== authDialogRevision) return;
    const labels = (window as any).__authDialogLabels;
    if (!supabase) {
      showAuthError(labels.serviceUnavailable);
      return;
    }
    const email = (document.getElementById("auth-email") as HTMLInputElement)?.value;
    const password = (document.getElementById("auth-password") as HTMLInputElement)?.value;
    const errorEl = document.getElementById("auth-dialog-error");
    if (errorEl) errorEl.classList.add("hidden");

    const mode = authDialogMode;
    const captchaToken = await requestFreshCaptchaToken(revision);
    if (revision !== authDialogRevision) return;
    if (turnstileEnabled() && !captchaToken) {
      showAuthError(labels.captchaUnavailable);
      return;
    }
    const authOptions = captchaToken ? { captchaToken } : {};
    const submittingLabels: Record<AuthDialogMode, string> = {
      signin: labels.signingIn,
      signup: labels.creatingAccount,
      reset: labels.sendingResetLink,
    };
    setSubmitBusy(true, submittingLabels[mode]);

    const finishFailure = (error: { message: string; status?: number }) => {
      if (error.status && error.status >= 500) {
        showAuthError(mode === "reset" ? labels.resetUnavailable : labels.serviceUnavailable);
      } else if (!error.status) {
        showAuthError(labels.networkError);
      } else {
        if (mode !== "reset" && error.status !== 429) recordFailure(AUTH_FAIL_KEY);
        showAuthError(error.message);
      }
    };

    if (mode === "reset") {
      const { error: resetError } = await supabase.auth.resetPasswordForEmail(email, {
        ...authOptions,
        redirectTo: passwordResetRedirectUrl(),
      });
      if (revision !== authDialogRevision) return;
      if (resetError) {
        finishFailure(resetError);
      } else {
        (document.getElementById("auth-dialog") as HTMLDialogElement)?.close();
        const labels = (window as any).__authDialogLabels;
        (window as any).__showSnackbar?.(labels.resetLinkSent, "info", 8000);
      }
    } else if (mode === "signup") {
      const { data, error: signUpError } = await supabase.auth.signUp({
        email,
        password,
        options: { ...authOptions, data: { full_name: email.split("@")[0] } },
      });
      if (revision !== authDialogRevision) return;
      if (signUpError) {
        finishFailure(signUpError);
      } else {
        recordSuccess(AUTH_FAIL_KEY);
        // Recorded as a "failure" so another signup within the window forces an interactive challenge.
        recordFailure(AUTH_SIGNUP_KEY, SIGNUP_WINDOW_MS);
        if (!data.session) {
          (document.getElementById("auth-dialog") as HTMLDialogElement)?.close();
          const labels = (window as any).__authDialogLabels;
          (window as any).__showSnackbar?.(labels?.confirmationSent || "Check your email to confirm your account.", "info", 8000);
        } else {
          (document.getElementById("auth-dialog") as HTMLDialogElement)?.close();
        }
      }
    } else {
      const { error: signInError } = await supabase.auth.signInWithPassword({
        email,
        password,
        options: authOptions,
      });
      if (revision !== authDialogRevision) return;
      if (signInError) {
        finishFailure(signInError);
      } else {
        recordSuccess(AUTH_FAIL_KEY);
        (document.getElementById("auth-dialog") as HTMLDialogElement)?.close();
      }
    }
  }

  async function authDialogGoogle() {
    const supabase = await getSupabaseClient();
    if (!supabase) return;
    // Return via /auth/callback so the session is persisted before any page reads it from localStorage.
    const next = window.location.pathname + window.location.search;
    const redirectTo = `${window.location.origin}/auth/callback?next=${encodeURIComponent(next)}`;
    await supabase.auth.signInWithOAuth({
      provider: "google",
      options: {
        redirectTo,
        queryParams: { prompt: "select_account" },
      },
    });
  }

  document.getElementById("auth-dialog-submit")?.addEventListener("click", authDialogSubmit);
  document.getElementById("auth-dialog-google")?.addEventListener("click", authDialogGoogle);
  document.getElementById("auth-dialog-switch")?.addEventListener("click", () => {
    authDialogMode = authDialogMode === "signin" ? "signup" : "signin";
    updateAuthDialogMode();
  });
  document.getElementById("auth-dialog-forgot")?.addEventListener("click", () => {
    authDialogMode = "reset";
    updateAuthDialogMode();
    document.getElementById("auth-email")?.focus();
  });
  document.getElementById("auth-dialog-close")?.addEventListener("click", () => {
    (document.getElementById("auth-dialog") as HTMLDialogElement)?.close();
  });

  // Clicks on the backdrop and on the dialog's own padding both target the <dialog>, so hit-test
  // the rect; the press must also start outside so a text-selection drag can't close it.
  const authDialogElement = document.getElementById("auth-dialog") as HTMLDialogElement | null;
  authDialogElement?.addEventListener("close", () => {
    authDialogRevision++;
    setSubmitBusy(false);
    authTurnstile.remove();
    turnstileRendered = false;
  });
  const outsideAuthDialog = (event: MouseEvent) => {
    if (!authDialogElement) return false;
    const rect = authDialogElement.getBoundingClientRect();
    return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
  };
  let authDialogPressStartedOutside = false;
  authDialogElement?.addEventListener("pointerdown", (event) => {
    authDialogPressStartedOutside = outsideAuthDialog(event);
  });
  authDialogElement?.addEventListener("click", (event) => {
    if (authDialogPressStartedOutside && outsideAuthDialog(event)) authDialogElement.close();
  });
  const submitOnEnter = (e: KeyboardEvent) => {
    if (e.key === "Enter") authDialogSubmit();
  };
  document.getElementById("auth-email")?.addEventListener("keydown", submitOnEnter);
  document.getElementById("auth-password")?.addEventListener("keydown", submitOnEnter);

  (window as any).__openAuthDialog = openAuthDialog;
</script>
