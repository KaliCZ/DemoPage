---
import "../styles/global.css";
import AuthDialog from "../components/AuthDialog.astro";
import Navbar from "../components/Navbar.astro";
import Snackbar from "../components/Snackbar.astro";
import Footer from "../components/Footer.astro";
import { locales, localePath, type Locale } from "../i18n/utils";
import { feed } from "../blog/feeds";

import enCommon from "../i18n/en/common.json";
import csCommon from "../i18n/cs/common.json";

interface Props {
  title: string;
  description?: string;
  activePage:
    | "home"
    | "about"
    | "projects"
    | "project"
    | "strong-types"
    | "blog"
    | "mcp"
    | "hire-me"
    | "job-offers"
    | "admin/job-offers"
    | "admin/test-errors"
    | "profile"
    | "reset-password"
    | "privacy"
    | "terms"
    | "oauth-consent";
  lang?: Locale;
  /** Canonical path override for pages nested under an activePage section (e.g. "blog/<slug>"). */
  pagePath?: string;
  /** Locales this page exists in, so hreflang never advertises a 404. */
  alternateLocales?: Locale[];
  /** Per-locale language-picker targets for pages whose counterpart is not simply pagePath (e.g. an untranslated post falls back to the blog index). */
  langUrls?: Partial<Record<Locale, string>>;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description = "Pavel Kalandra — CTO & Software Engineering Leader. Personal showcase built in public at kalandra.tech.",
  activePage,
  lang = "en",
  pagePath,
  alternateLocales = locales,
  langUrls,
  ogType = "website",
  noindex = false,
} = Astro.props;

const t = lang === "cs" ? csCommon : enCommon;

const siteUrl = "https://www.kalandra.tech";
const canonicalPage = pagePath ?? activePage;
const enUrl = `${siteUrl}${localePath("en", canonicalPage)}`;
const csUrl = `${siteUrl}${localePath("cs", canonicalPage)}`;
const canonicalUrl = lang === "cs" ? csUrl : enUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Pavel Kalandra" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#f3f1ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131313" media="(prefers-color-scheme: dark)" />

    <!-- hreflang needs a pair, so single-locale pages emit only the canonical -->
    <link rel="canonical" href={canonicalUrl} />
    {alternateLocales.length > 1 && (
      <>
        {alternateLocales.map((locale) => (
          <link rel="alternate" hreflang={locale} href={locale === "cs" ? csUrl : enUrl} />
        ))}
        <link rel="alternate" hreflang="x-default" href={alternateLocales.includes("en") ? enUrl : csUrl} />
      </>
    )}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.path} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="kalandra.tech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === "cs" ? "cs_CZ" : "en_US"} />
    {alternateLocales.includes(lang === "cs" ? "en" : "cs") && (
      <meta property="og:locale:alternate" content={lang === "cs" ? "en_US" : "cs_CZ"} />
    )}

    <!-- Must match the @font-face URLs in global.css, or the preload is wasted. -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    {lang !== "en" && (
      <>
        <link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/manrope-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/space-grotesk-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    {/* Loaded in <head> so Sentry initializes before the islands make their first API calls. */}
    <script>
      import "../lib/observability";
    </script>
    <script>
      // Dev-only OTel; the DEV constant lets Vite drop this branch (and its ~100 KB of deps) from prod.
      if (import.meta.env.DEV) {
        import("../lib/otel-dev").catch((err) => {
          console.error("[otel-dev] dynamic import failed:", err);
        });
      }
    </script>
    <slot name="head" />

    <script is:inline>
      (function () {
        // Exposed as data-theme-pref so the theme picker highlights the active option on first paint.
        var pref = localStorage.getItem("theme");
        if (pref !== "light" && pref !== "dark") pref = "system";
        document.documentElement.dataset.themePref = pref;
        if (pref === "dark" || (pref === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
          // MutationObserver callbacks run before the next paint, so [data-src-dark] images never flash their light src.
          var swap = function (img) {
            if (!img.dataset.srcLight) img.dataset.srcLight = img.getAttribute("src") || "";
            var dark = img.dataset.srcDark;
            if (dark && img.getAttribute("src") !== dark) img.setAttribute("src", dark);
          };
          var obs = new MutationObserver(function () {
            document.querySelectorAll("img[data-src-dark]").forEach(swap);
          });
          obs.observe(document.documentElement, { childList: true, subtree: true });
          document.addEventListener(
            "DOMContentLoaded",
            function () {
              document.querySelectorAll("img[data-src-dark]").forEach(swap);
              obs.disconnect();
            },
            { once: true },
          );
        }
        // Reads supabase-js's persisted session (sb-<project-ref>-auth-token) so the header paints the right auth state and chip width with no flash.
        try {
          var session = null;
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && k.indexOf("sb-") === 0 && k.indexOf("-auth-token") === k.length - 11) {
              var v = localStorage.getItem(k);
              if (v && v.length > 2) {
                try {
                  session = JSON.parse(v);
                } catch (_) {}
                break;
              }
            }
          }
          if (session && session.user) {
            var u = session.user;
            var meta = u.user_metadata || {};
            window.__authPrefill = {
              name: meta.full_name || (u.email ? u.email.split("@")[0] : "User"),
              email: u.email || "",
              avatar: meta.avatar_url || "",
              isAdmin: !!(u.app_metadata && Array.isArray(u.app_metadata.roles) && u.app_metadata.roles.indexOf("admin") !== -1),
            };
            document.documentElement.classList.add("auth-known-in");
          } else {
            document.documentElement.classList.add("auth-known-out");
          }
        } catch (e) {
          document.documentElement.classList.add("auth-known-out");
        }
      })();
    </script>
    <style is:global>
      /* !important beats Tailwind's `hidden` until updateAuthUI removes the auth-known-* class. */
      html.auth-known-in #auth-sign-in-desktop,
      html.auth-known-in #auth-sign-in-mobile {
        display: none !important;
      }
      html.auth-known-in #auth-profile-desktop {
        display: block !important;
      }
      html.auth-known-in #auth-profile-mobile {
        display: block !important;
      }
      html.auth-known-out #auth-profile-desktop,
      html.auth-known-out #auth-profile-mobile {
        display: none !important;
      }

      html.auth-known-in .signed-out-only {
        display: none !important;
      }
      html.auth-known-out .signed-in-only {
        display: none !important;
      }
      html.auth-known-in .signed-in-only {
        display: block !important;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar activePage={activePage} lang={lang} langUrls={langUrls} t={t} />

    <script is:inline>
      // Inline right after Navbar so the profile chip is filled from __authPrefill before first paint.
      (function () {
        var p = window.__authPrefill;
        if (!p) return;
        var nameEl = document.getElementById("auth-name-desktop");
        if (nameEl) nameEl.textContent = p.name;
        var avatarDesktop = document.getElementById("auth-avatar-desktop");
        var avatarMobile = document.getElementById("auth-avatar-mobile");
        function applyAvatar(img) {
          if (!img) return;
          if (p.avatar) {
            img.src = p.avatar;
            img.alt = p.name;
          } else {
            img.style.display = "none";
            var placeholder = img.nextElementSibling;
            if (placeholder) {
              placeholder.classList.remove("hidden");
              placeholder.textContent = (p.name.charAt(0) || "?").toUpperCase();
            }
          }
        }
        applyAvatar(avatarDesktop);
        applyAvatar(avatarMobile);
        var adminLink = document.getElementById("auth-admin-link-desktop");
        if (adminLink && p.isAdmin) adminLink.classList.remove("hidden");
        var adminTestErrorsLink = document.getElementById("auth-admin-test-errors-desktop");
        if (adminTestErrorsLink && p.isAdmin) adminTestErrorsLink.classList.remove("hidden");
      })();
    </script>
    <main id="main-content" class="pt-32 pb-24 flex-1">
      <slot />
    </main>

    <Footer lang={lang} t={t} />

    <script>
      import "../lib/theme-toggle";
    </script>
    <AuthDialog lang={lang} />

    <script>
      import "../lib/api-errors";
      import { identifyUser } from "../lib/observability";
      import { getSupabaseClient } from "../lib/supabase";

      function setAvatarOrInitial(imgEl: HTMLImageElement | null, name: string, avatarUrl: string) {
        if (!imgEl) return;
        if (avatarUrl) {
          imgEl.src = avatarUrl;
          imgEl.alt = name;
          imgEl.style.display = "";
          imgEl.nextElementSibling?.classList.add("hidden");
        } else {
          imgEl.style.display = "none";
          const placeholder = imgEl.nextElementSibling;
          if (placeholder) {
            placeholder.classList.remove("hidden");
            placeholder.textContent = (name.charAt(0) || "?").toUpperCase();
          }
        }
      }

      function updateAuthUI(user: any) {
        identifyUser(user);

        // JS owns visibility from here; the pre-paint auth-known-* !important rules would pin the initial state across sign-in/out.
        document.documentElement.classList.remove("auth-known-in", "auth-known-out");

        const signInDesktop = document.getElementById("auth-sign-in-desktop");
        const profileDesktop = document.getElementById("auth-profile-desktop");
        const avatarDesktop = document.getElementById("auth-avatar-desktop") as HTMLImageElement;
        const nameDesktop = document.getElementById("auth-name-desktop");
        const signInMobile = document.getElementById("auth-sign-in-mobile");
        const profileMobile = document.getElementById("auth-profile-mobile");
        const avatarMobile = document.getElementById("auth-avatar-mobile") as HTMLImageElement;
        const adminLinkDesktop = document.getElementById("auth-admin-link-desktop");
        const adminTestErrorsDesktop = document.getElementById("auth-admin-test-errors-desktop");

        if (user) {
          const name = user.user_metadata?.full_name || user.email?.split("@")[0] || "User";
          const avatar = user.user_metadata?.avatar_url || "";
          const isAdmin = Array.isArray(user.app_metadata?.roles) && user.app_metadata.roles.indexOf("admin") !== -1;

          if (signInDesktop) signInDesktop.classList.add("hidden");
          if (profileDesktop) {
            profileDesktop.classList.remove("hidden");
            setAvatarOrInitial(avatarDesktop, name, avatar);
            if (nameDesktop) nameDesktop.textContent = name;
          }
          if (signInMobile) signInMobile.classList.add("hidden");
          if (profileMobile) {
            profileMobile.classList.remove("hidden");
            setAvatarOrInitial(avatarMobile, name, avatar);
          }
          if (adminLinkDesktop) adminLinkDesktop.classList.toggle("hidden", !isAdmin);
          if (adminTestErrorsDesktop) adminTestErrorsDesktop.classList.toggle("hidden", !isAdmin);

          window.dispatchEvent(new CustomEvent("auth-change", { detail: { user } }));
        } else {
          if (signInDesktop) signInDesktop.classList.remove("hidden");
          if (profileDesktop) profileDesktop.classList.add("hidden");
          if (signInMobile) signInMobile.classList.remove("hidden");
          if (profileMobile) profileMobile.classList.add("hidden");
          if (adminLinkDesktop) adminLinkDesktop.classList.add("hidden");
          if (adminTestErrorsDesktop) adminTestErrorsDesktop.classList.add("hidden");

          window.dispatchEvent(new CustomEvent("auth-change", { detail: { user: null } }));
        }
      }

      const openDialog = () => (window as any).__openAuthDialog?.();
      document.getElementById("auth-sign-in-desktop")?.addEventListener("click", openDialog);
      document.getElementById("auth-sign-in-mobile")?.addEventListener("click", openDialog);
      document.getElementById("auth-sign-out-desktop")?.addEventListener("click", async () => {
        const supabase = await (window as any).__supabaseReady;
        if (!supabase) return;
        await supabase.auth.signOut();
        updateAuthUI(null);
      });

      // Deferred past window.load so the supabase chunk doesn't compete with LCP-critical resources.
      const initSupabase = () =>
        getSupabaseClient().then((supabase) => {
          if (!supabase) return null;

          supabase.auth.getSession().then(({ data: { session } }) => {
            updateAuthUI(session?.user ?? null);
          });

          supabase.auth.onAuthStateChange((_event, session) => {
            updateAuthUI(session?.user ?? null);
          });

          (window as any).__supabase = supabase;
          return supabase;
        });

      (window as any).__supabaseReady = new Promise<any>((resolve) => {
        const start = () => resolve(initSupabase());
        if (document.readyState === "complete") {
          setTimeout(start, 0);
        } else {
          window.addEventListener("load", () => setTimeout(start, 0), { once: true });
        }
      });

      (window as any).__getAccessToken = async () => {
        const supabase = await getSupabaseClient();
        if (!supabase) return null;
        const {
          data: { session },
        } = await supabase.auth.getSession();
        return session?.access_token ?? null;
      };
      (window as any).__getUser = async () => {
        const supabase = await getSupabaseClient();
        if (!supabase) return null;
        const {
          data: { session },
        } = await supabase.auth.getSession();
        return session?.user ?? null;
      };
    </script>
    <Snackbar />

    <script>
      import enCommonHash from "../i18n/en/common.json";
      import csCommonHash from "../i18n/cs/common.json";

      // An auth error fragment (e.g. an expired confirmation link) signs out any session, since whoever clicked the link is the one who signed up.
      const hashParams = new URLSearchParams(window.location.hash.substring(1));
      const authError = hashParams.get("error_description");
      const strayAccessToken = hashParams.get("access_token");
      if (authError) {
        (window as any).__supabaseReady?.then((s: any) => s?.auth.signOut());
        (window as any).__showSnackbar(decodeURIComponent(authError), "error", 0);
        history.replaceState(null, "", window.location.pathname + window.location.search);
      } else if (strayAccessToken) {
        // OAuth tokens only belong at /auth/callback, so one here means an old or reused link.
        (window as any).__supabaseReady?.then((s: any) => s?.auth.signOut());
        const lang = document.documentElement.lang === "cs" ? "cs" : "en";
        const msg = (lang === "cs" ? csCommonHash : enCommonHash).auth.callbackError;
        (window as any).__showSnackbar(msg, "error", 0);
        history.replaceState(null, "", window.location.pathname + window.location.search);
      }
    </script>
    <script>
      import "../lib/details-animation";
    </script>
  </body>
</html>
